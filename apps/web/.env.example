# API base for the web app to talk to
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Only the Next.js server reads these. For local development, point this to
# a localhost-only SSH tunnel into the Arch Ollama host — never expose Ollama
# directly to the LAN or public internet.
LOCAL_OLLAMA_BASE_URL=http://127.0.0.1:11435
LOCAL_OLLAMA_MODEL=qwen3:8b

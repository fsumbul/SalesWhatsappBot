# Application
APP_ENV=development
APP_DEBUG=true
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=change-me-please-min-32-chars-long-secret
APP_BASE_URL=http://localhost:8000
WEB_BASE_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql+asyncpg://leadpulse:leadpulse@localhost:5432/leadpulse

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# JWT
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

# CORS (comma-separated)
CORS_ORIGINS=http://localhost:3000

# WhatsApp Cloud API (Meta)
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=set-to-any-random-string-you-configure-in-meta
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# Discovery data sources
GOOGLE_PLACES_API_KEY=
SERPAPI_KEY=
BING_SEARCH_KEY=

# İYS (Turkey commercial-message registry)
IYS_API_URL=
IYS_API_KEY=

# Observability
SENTRY_DSN=
LOG_LEVEL=INFO

# SMTP (for invitations, alerts)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@leadpulse.local

# === App ===
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=change-me-to-a-strong-random-secret-at-least-32-chars
APP_BASE_URL=http://localhost:8000
WEB_BASE_URL=http://localhost:3000

# === Database ===
# POSTGRES_USER/PASSWORD is the Postgres bootstrap superuser (created by the
# postgres Docker image). It must NEVER be what the running app connects as:
# Postgres does not enforce Row-Level Security for superuser connections, so
# using it here would silently disable tenant isolation. See
# docs/architecture.md "Multi-tenant izolasyon".
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=leadpulse
POSTGRES_USER=leadpulse
POSTGRES_PASSWORD=leadpulse_dev

# Restricted, non-superuser role the running API/worker processes use.
# Created by migration 0ba5bf6fe643_create_restricted_app_role; its password
# must match LEADPULSE_APP_DB_PASSWORD below (change both together).
LEADPULSE_APP_DB_PASSWORD=leadpulse_app_dev
DATABASE_URL=postgresql+asyncpg://leadpulse_app:leadpulse_app_dev@localhost:5432/leadpulse

# Superuser connection string — used ONLY to run `alembic upgrade head`
# (DDL + role/grant management). Falls back to DATABASE_URL if unset, but in
# a properly isolated setup DATABASE_URL is the restricted role above, so set
# this explicitly whenever you run migrations.
MIGRATIONS_DATABASE_URL=postgresql+asyncpg://leadpulse:leadpulse_dev@localhost:5432/leadpulse

# === Redis / Celery ===
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# === JWT ===
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

# === CORS ===
CORS_ORIGINS=http://localhost:3000

# === External APIs (fill in later) ===
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_GRAPH_API_VERSION=v20.0
WHATSAPP_AGENT_SLUG=

GOOGLE_PLACES_API_KEY=
SERPAPI_KEY=
BING_SEARCH_KEY=

IYS_API_URL=
IYS_API_KEY=

# === Web crawler (Phase D) === off by default; see docs/architecture.md
# "Web crawler (Phase D)" before configuring seed URLs.
WEB_CRAWL_ENABLED=false
WEB_CRAWL_SEED_URLS=
WEB_CRAWL_PROXIES=

# === LLM provider ===
# Supported: ollama, chat_compatible, mock (development only).
# ``chat_compatible`` works with self-hosted vLLM, LocalAI, llama.cpp and
# similar Chat Completions servers on any operating system or in a container.
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
# Ollama: http://host:11434 (or /v1); chat_compatible: https://host/v1
LLM_BASE_URL=http://localhost:11434/v1

# === NVIDIA NIM harness agents (self-hosted) ===
# Guardrail / OCR / vision / embedding / rerank / ASR / translation adapters
# talk to NIM containers on YOUR OWN GPU host (infra/docker-compose.nim.yml).
# Public build.nvidia.com trial hosts log inputs and are refused for every
# endpoint that sees customer or tenant data. Shared key is optional; each
# feature's *_API_KEY wins. Plan: docs/nvidia-nim-harness-agents-plan-2026-09-16.md
NIM_API_KEY=
NIM_TIMEOUT_SECONDS=10
NIM_PUBLIC_HOST_DENYLIST=integrate.api.nvidia.com,ai.api.nvidia.com,api.nvcf.nvidia.com

# === Guardrail gate (NIM plan WP1) ===
# Customer messages are classified BEFORE any model call; document chunks
# before extraction. closed = unreachable classifier -> approved safe turn,
# no model call (mandatory in production). Checks: jailbreak, content_safety,
# topic_control (topic control only flags by default).
GUARDRAIL_ENABLED=false
GUARDRAIL_FAIL_MODE=closed
GUARDRAIL_TIMEOUT_SECONDS=2.5
GUARDRAIL_CHECKS=jailbreak,content_safety,topic_control
GUARDRAIL_INGEST_ENABLED=true
# nemoguard-jailbreak-detect NIM (POST /v1/classify)
GUARDRAIL_JAILBREAK_BASE_URL=
GUARDRAIL_JAILBREAK_API_KEY=
GUARDRAIL_JAILBREAK_THRESHOLD=0.0
# content-safety NIM (chat completions, Aegis taxonomy S1..S23)
GUARDRAIL_CONTENT_SAFETY_BASE_URL=
GUARDRAIL_CONTENT_SAFETY_MODEL=llama-3.1-nemoguard-8b-content-safety
GUARDRAIL_CONTENT_SAFETY_API_KEY=
# Categories that block on their own (S9 PII, S12 profanity, S13/S14 only flag).
GUARDRAIL_BLOCK_CATEGORIES=S1,S2,S3,S4,S5,S6,S7,S8,S10,S11,S15,S16,S17,S22
# topic-control NIM (chat completions; answers on-topic/off-topic)
GUARDRAIL_TOPIC_CONTROL_BASE_URL=
GUARDRAIL_TOPIC_CONTROL_MODEL=llama-3.1-nemoguard-8b-topic-control
GUARDRAIL_TOPIC_CONTROL_API_KEY=
GUARDRAIL_TOPIC_CONTROL_MODE=flag
GUARDRAIL_TOPIC_MIN_TOKENS=3

# === Knowledge retrieval / GraphRAG (ADR-002) ===
# lexical = in-process keyword retriever (default, no extra services).
# falkordb = hybrid graph + vector (BGE-M3) + Turkish full-text retrieval with
# optional cross-encoder rerank; falls back to lexical automatically.
KNOWLEDGE_BACKEND=lexical
FALKORDB_HOST=localhost
FALKORDB_PORT=6381
FALKORDB_USERNAME=
FALKORDB_PASSWORD=
# Embedding profile (Ollama `ollama pull bge-m3`, 1024 dims). Empty base URL
# derives the Ollama root from LLM_BASE_URL.
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=bge-m3
EMBEDDING_BASE_URL=
EMBEDDING_DIMENSION=1024
# bge-reranker-v2-m3 via sentence-transformers (first load downloads ~2.2 GB).
RERANKER_ENABLED=false
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_DEVICE=auto
RETRIEVAL_MAX_CANDIDATES=12
RETRIEVAL_RERANK_POOL=24
RETRIEVAL_TIMEOUT_SECONDS=4
# Background per-customer memory graph (knowledge Celery queue).
MEMORY_ENRICHMENT_ENABLED=true

# === Self-service knowledge sources (ADR-003) ===
# Tenants upload PDF/XLSX/CSV/Markdown or register their website; extracted
# facts auto-publish above the threshold (never protected topics), images are
# re-hosted at /media/k/<tenant>/<sha>.<ext>. Everything is revocable.
KNOWLEDGE_AUTO_PUBLISH=true
KNOWLEDGE_AUTO_PUBLISH_THRESHOLD=0.75
KNOWLEDGE_PUBLISH_TARGET=live
KNOWLEDGE_DOCUMENT_MAX_BYTES=20971520
KNOWLEDGE_CRAWL_MAX_PAGES=60
KNOWLEDGE_CRAWL_MAX_DEPTH=3
KNOWLEDGE_CRAWL_USER_AGENT=LeadPulseBot/1.0
KNOWLEDGE_MEDIA_MIN_PIXELS=300
KNOWLEDGE_MEDIA_MAX_PER_SUBJECT=3
# Public HTTPS origin Meta fetches product images from (empty = APP_BASE_URL).
KNOWLEDGE_PUBLIC_MEDIA_BASE_URL=

# === Hybrid response mode (ADR-003) ===
# response_mode=hybrid tenants may get model-written descriptive answers that
# cite evidence and pass a deterministic audit; protected topics stay literal.
HYBRID_GENERATION_ENABLED=true
# Ollama context window; raise to 8192 when max_evidence_chunks > 2.
LLM_NUM_CTX=4096

# === Observability ===
SENTRY_DSN=
LOG_LEVEL=INFO

# === SMTP (dev uses mailhog) ===
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@leadpulse.local
